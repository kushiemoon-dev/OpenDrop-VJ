target/
Cargo.lock.bak

# Local editor state
.vscode/

# AppImage packaging build artifacts (regenerated by build-appimage.sh)
/packaging/appimage/AppDir/
/packaging/appimage/.cache/
/*.AppImage

# Windows NDI runtime DLL (Processing.NDI.Lib.x64.dll, ~28.5 MB): not
# committed, same policy as libndi.so.6 in the AppImage build and the
# vcpkg-sourced projectM DLLs, copied at package time from the NDI SDK
# installed on the Windows build machine
# (C:\Program Files\NDI\NDI 6 SDK\Bin\x64\Processing.NDI.Lib.x64.dll).
/packaging/windows/Processing.NDI.Lib.x64.dll

# Windows portable zip packaging build artifacts (regenerated by
# build-portable.ps1): the assembled flat folder and its zip.
/OpenDrop-Native-*-windows-x64/
/OpenDrop-Native-*-windows-x64.zip

# Local CDN video clip source (179 MB of webm): content for loops.kushie.dev,
# not app code.
/cdn-video-loops/

# makepkg build artifacts when testing packaging/aur/PKGBUILD locally.
/packaging/aur/src/
/packaging/aur/pkg/
/packaging/aur/*.pkg.tar.zst
/packaging/aur/*.AppImage
