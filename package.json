{
	"name": "opendrop",
	"private": true,
	"version": "0.7.0",
	"homepage": "https://opendrop.kushie.dev",
	"type": "module",
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "vite dev",
		"presets:build": "node scripts/build-presets.mjs",
		"video-loops:build": "node scripts/build-video-loops.mjs",
		"build": "node scripts/build-presets.mjs && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:coverage": "vitest --coverage",
		"test:e2e": "playwright test",
		"electron:dev": "concurrently \"vite dev\" \"wait-on http://localhost:1420 && electron .\"",
		"electron:build": "vite build && electron-builder",
		"electron:rebuild": "electron-rebuild -f -w grandiose",
		"electron:rebuild:spout": "electron-rebuild -f -w spout-addon",
		"electron:rebuild:link": "electron-rebuild -f -w @ktamas77/abletonlink"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"butterchurn": "^2.6.7",
		"milkdrop-preset-converter": "^0.1.2",
		"ws": "^8.21.0"
	},
	"optionalDependencies": {
		"@ktamas77/abletonlink": "^1.2.3",
		"audify": "^1.10.1",
		"grandiose": "^0.0.4",
		"spout-addon": "file:native/spout"
	},
	"devDependencies": {
		"@electron/rebuild": "^4.0.4",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.65.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^25.9.3",
		"@types/ws": "^8.18.1",
		"@vitest/coverage-v8": "^3.2.6",
		"concurrently": "^10.0.3",
		"electron": "^42.4.1",
		"electron-builder": "^26.15.3",
		"jsdom": "^29.0.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^3.2.6",
		"wait-on": "^8.0.5"
	}
}
