{
    "version": "@VERSION@",
    "description": "Native 4-deck Milkdrop VJ instrument built on projectM, with MIDI/OSC control, NDI and Spout",
    "homepage": "https://opendrop.kushie.dev",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/kushiemoon-dev/OpenDrop-VJ/releases/download/v@VERSION@/OpenDrop-Native-@VERSION@-windows-x64.zip",
            "hash": "@SHA256@",
            "extract_dir": "OpenDrop-Native-@VERSION@-windows-x64"
        }
    },
    "bin": [
        [
            "opendrop-app.exe",
            "opendrop-vj"
        ]
    ],
    "shortcuts": [
        [
            "opendrop-app.exe",
            "OpenDrop VJ"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/kushiemoon-dev/OpenDrop-VJ/releases/download/v$version/OpenDrop-Native-$version-windows-x64.zip",
                "extract_dir": "OpenDrop-Native-$version-windows-x64"
            }
        }
    }
}
